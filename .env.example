# arkserver-panel config. Copy to .env and set the admin credential. NEVER commit real secrets.

# Bind address. Default 127.0.0.1:8080 (local only). For LAN/container use 0.0.0.0:8080 and
# publish the port only to your trusted LAN (remote access via VPN). Basic Auth is the gate; over
# plain HTTP use only inside a trusted LAN.
PANEL_ADDR=127.0.0.1:8080

# Admin credential (HTTP Basic Auth). REQUIRED — the server refuses to start without both.
PANEL_USER=admin
PANEL_PASS=change-me

# RCON access to the game server, used for the player list and the restart action. The address
# defaults to the compose service alias; override it when the panel runs outside that network.
# ARK_ADMIN_PASSWORD must match ADMIN_PASSWORD in the server's own .env. Without it the panel still
# starts, and the features that need RCON report as unavailable.
ARK_RCON_ADDR=ark:27020
ARK_ADMIN_PASSWORD=

# Where the server volume is mounted in the panel container. The installed build id is read from
# SteamCMD's app manifest below this path, and the INIs are edited here.
ARK_DATA_DIR=/data

# Where the deployment directory holding the server's .env is mounted, read-only. The panel shows
# that file but never writes it: its values only take effect when the container is created, so a
# save would look like a change without being one. Mount the directory, not the single file.
ARK_ENV_DIR=/deploy

# Docker access for the CPU/RAM figures and the start/stop actions, always through the path-filtered
# socket proxy: the panel must never be given the socket itself. Leave ARK_DOCKER_HOST empty to run
# without it; the panel then hides those features and everything else keeps working.
# ARK_CONTAINER is the container's NAME as the Docker API knows it, which is not the compose service
# alias that ARK_RCON_ADDR uses.
ARK_DOCKER_HOST=http://socket-proxy:2375
ARK_CONTAINER=ark_server

# How the server is reached from outside, for the connect line on the status page: a public address
# or a name, with or without a port (the game port is taken from what the host published). Empty
# leaves that line open rather than guessing. The panel does not look this up: it is bound to the
# local network on purpose, and a service in that position must not ask an outside party for its own
# address.
ARK_PUBLIC_HOST=
