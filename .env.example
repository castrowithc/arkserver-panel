# arkserver-panel config. Copy to .env and set the admin credential. NEVER commit real secrets.

# Bind address. Default 127.0.0.1:8080 (local only). For LAN/container use 0.0.0.0:8080 and
# publish the port only to your trusted LAN (remote access via VPN). Basic Auth is the gate; over
# plain HTTP use only inside a trusted LAN.
PANEL_ADDR=127.0.0.1:8080

# Admin credential (HTTP Basic Auth). REQUIRED — the server refuses to start without both.
PANEL_USER=admin
PANEL_PASS=change-me
