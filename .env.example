# arkserver-panel config. Copy to .env and set the admin credential. NEVER commit real secrets.

# Bind address. Default 127.0.0.1:8080 (local only). For LAN/container use 0.0.0.0:8080 and
# publish the port only to your trusted LAN (remote access via VPN). Basic Auth is the gate; over
# plain HTTP use only inside a trusted LAN.
PANEL_ADDR=127.0.0.1:8080

# Admin credential (HTTP Basic Auth). REQUIRED — the server refuses to start without both.
PANEL_USER=admin
PANEL_PASS=change-me

# RCON access to the game server, used for the player list and the restart action. The address
# defaults to the compose service alias; override it when the panel runs outside that network.
# ARK_ADMIN_PASSWORD must match ADMIN_PASSWORD in the server's own .env. Without it the panel still
# starts, and the features that need RCON report as unavailable.
ARK_RCON_ADDR=ark:27020
ARK_ADMIN_PASSWORD=

# Where the server volume is mounted in the panel container. The installed build id is read from
# SteamCMD's app manifest below this path; later phases edit the INIs here too.
ARK_DATA_DIR=/data
